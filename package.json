{
  "name": "@investflow/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "docker compose down -v && docker compose up -d --wait && nx run shared-infrastructure:prisma-migrate-deploy && pnpm db:seed",
    "start": "pnpm db:up && nx run-many -t serve -p api web --parallel=2",
    "start:api": "nx serve api",
    "build:api": "nx build api",
    "start:web": "nx serve web",
    "build:web": "nx build web",
    "test:web": "nx test web",
    "db:generate": "nx run shared-infrastructure:prisma-generate",
    "db:migrate": "nx run shared-infrastructure:prisma-migrate-dev",
    "db:seed": "nx run shared-infrastructure:prisma-seed",
    "lint": "nx run-many -t lint",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test --passWithNoTests",
    "check": "nx run-many -t lint,test,typecheck,build --outputStyle=static"
  },
  "private": true,
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1034.0",
    "@aws-sdk/client-sqs": "^3.1034.0",
    "@base-ui/react": "^1.9.0",
