DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=investflow

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investflow?schema=public

# Keycloak
KC_PORT=8080
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
KC_DB_NAME=keycloak

# NestJS → Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=investflow
KEYCLOAK_CLIENT_ID=investflow-api
KEYCLOAK_CLIENT_SECRET=dev-investflow-api-secret

# AWS
# AWS_ENDPOINT=http://localhost:4566  # Uncomment for LocalStack (not wired yet)
AWS_REGION=us-east-1
SNS_INVESTMENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:investflow-investments
SQS_PORTFOLIO_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/investflow-portfolio-events
