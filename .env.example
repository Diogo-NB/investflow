DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=investflow

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investflow?schema=public
# Integration tests (pnpm check:integration) migrate and use this database
INTEGRATION_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investflow_test?schema=public

# Keycloak
KC_PORT=8080
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
KC_DB_NAME=keycloak
WEB_APP_ORIGIN=http://localhost:4200

# The API validates Keycloak tokens: issuer KEYCLOAK_URL/realms/KEYCLOAK_REALM,
# audience KEYCLOAK_CLIENT_ID
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=investflow
KEYCLOAK_CLIENT_ID=investflow-api

# AWS (Floci locally). A shell AWS_PROFILE takes precedence over this key
# pair; Floci accepts any credentials, but the profile must still resolve.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
FLOCI_PORT=4566
EVENT_BUS_NAME=investflow
SIMULATION_CALCULATIONS_QUEUE_URL=http://localhost:4566/000000000000/simulation-calculations.fifo
SIMULATION_CALCULATIONS_DLQ_URL=http://localhost:4566/000000000000/simulation-calculations-dlq.fifo
SIMULATION_RECALCULATIONS_QUEUE_URL=http://localhost:4566/000000000000/simulation-recalculations.fifo
# No consumer reads it: a dead-lettered fan-out wrote nothing and is redriven.
SIMULATION_RECALCULATIONS_DLQ_URL=http://localhost:4566/000000000000/simulation-recalculations-dlq.fifo
