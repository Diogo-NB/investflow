{
  "name": "market-data-infrastructure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/market-data/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:market-data", "layer:infrastructure", "platform:server"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/market-data/infrastructure",
        "main": "libs/market-data/infrastructure/src/index.ts",
        "tsConfig": "libs/market-data/infrastructure/tsconfig.lib.json",
        "assets": ["libs/market-data/infrastructure/*.md"]
      }
    },
    "integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["shared-infrastructure"],
          "target": "prisma-migrate-test-database"
        }
      ],
      "options": {
        "command": "env -u AWS_PROFILE NODE_OPTIONS=--experimental-vm-modules pnpm exec jest --config libs/market-data/infrastructure/jest.config.cts --testPathIgnorePatterns=/node_modules/ --testMatch='**/*.integration.spec.ts'"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc -p libs/market-data/infrastructure/tsconfig.spec.json --noEmit"
      }
    }
  }
}
