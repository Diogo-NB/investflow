{
  "name": "investment-simulator-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/investment-simulator/web/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [
    "scope:investment-simulator",
    "platform:browser",
    "type:web-feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/investment-simulator/web/ng-package.json",
        "tsConfig": "libs/investment-simulator/web/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/investment-simulator/web/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {}
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
