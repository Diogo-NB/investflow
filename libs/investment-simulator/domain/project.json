{
  "name": "investment-simulator-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/investment-simulator/domain/src",
  "projectType": "library",
  "tags": ["scope:investment-simulator", "layer:domain", "platform:server"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/investment-simulator/domain",
        "main": "libs/investment-simulator/domain/src/index.ts",
        "tsConfig": "libs/investment-simulator/domain/tsconfig.lib.json",
        "assets": ["libs/investment-simulator/domain/*.md"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "command": "tsc -p libs/investment-simulator/domain/tsconfig.spec.json --noEmit"
      }
    }
  }
}
