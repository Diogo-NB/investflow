{
  "name": "shared-infrastructure",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/infrastructure/src",
  "projectType": "library",
  "tags": ["scope:shared", "layer:infrastructure"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/infrastructure",
        "tsConfig": "libs/shared/infrastructure/tsconfig.lib.json",
        "packageJson": "libs/shared/infrastructure/package.json",
        "main": "libs/shared/infrastructure/src/index.ts",
        "assets": ["libs/shared/infrastructure/*.md"],
        "rootDir": "."
      }
    },
    "prisma-generate": {
      "command": "pnpm prisma generate --config=libs/shared/infrastructure/prisma/prisma.config.ts"
    },
    "prisma-migrate-dev": {
      "command": "pnpm prisma migrate dev --config=libs/shared/infrastructure/prisma/prisma.config.ts"
    },
    "prisma-migrate-deploy": {
      "command": "pnpm prisma migrate deploy --config=libs/shared/infrastructure/prisma/prisma.config.ts"
    },
    "prisma-studio": {
      "command": "pnpm prisma studio --config=libs/shared/infrastructure/prisma/prisma.config.ts"
    }
  }
}
