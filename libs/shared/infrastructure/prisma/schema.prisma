generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvestmentTitleType {
  CDB
  LCI
  LCA

  @@map("investment_title_type")
}

enum InvestmentRedemptionType {
  AT_MATURITY
  DAILY

  @@map("investment_redemption_type")
}

enum InvestmentRemunerationType {
  PREFIXED
  CDI_PERCENTAGE
  SELIC_PERCENTAGE
  IPCA_PLUS

  @@map("investment_remuneration_type")
}

model InvestmentIssuer {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  offers    InvestmentOffer[]
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("investment_issuer")
}

model InvestmentOffer {
  id               String                     @id @default(uuid()) @db.Uuid
  titleType        InvestmentTitleType        @map("title_type")
  issuerId         String                     @map("issuer_id") @db.Uuid
  maturityDate     DateTime                   @map("maturity_date") @db.Date
  redemptionType   InvestmentRedemptionType   @map("redemption_type")
  remunerationType InvestmentRemunerationType @map("remuneration_type")
  rateValue        Decimal                    @map("rate_value") @db.Decimal(65, 30)
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  issuer           InvestmentIssuer           @relation(fields: [issuerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([issuerId])
  @@index([deletedAt])
  @@map("investment_offer")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  context       String
  occurredAt    DateTime  @map("occurred_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  id          String   @id @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
