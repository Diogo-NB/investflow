generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvestmentTitleType {
  CDB
  LCI
  LCA

  @@map("investment_title_type")
}

enum InvestmentRedemptionType {
  AT_MATURITY
  DAILY

  @@map("investment_redemption_type")
}

enum InvestmentRemunerationType {
  PREFIXED
  CDI_PERCENTAGE
  SELIC_PERCENTAGE
  IPCA_PLUS

  @@map("investment_remuneration_type")
}

model InvestmentIssuer {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  offers      InvestmentOffer[]
  simulations Simulation[]
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("investment_issuer")
}

model InvestmentOffer {
  id               String                     @id @default(uuid()) @db.Uuid
  titleType        InvestmentTitleType        @map("title_type")
  issuerId         String?                    @map("issuer_id") @db.Uuid
  maturityDate     DateTime                   @map("maturity_date") @db.Date
  redemptionType   InvestmentRedemptionType   @map("redemption_type")
  remunerationType InvestmentRemunerationType @map("remuneration_type")
  rateValue        Decimal                    @map("rate_value") @db.Decimal(65, 30)
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  issuer           InvestmentIssuer?          @relation(fields: [issuerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  simulations      Simulation[]

  @@index([issuerId])
  @@map("investment_offer")
}

model Simulation {
  id               String                     @id @db.Uuid
  ownerId          String                     @map("owner_id")
  // The catalog offer the terms were filled from; null for typed terms.
  sourceOfferId    String?                    @map("source_offer_id") @db.Uuid
  titleType        InvestmentTitleType        @map("title_type")
  issuerId         String?                    @map("issuer_id") @db.Uuid
  maturityDate     DateTime                   @map("maturity_date") @db.Date
  redemptionType   InvestmentRedemptionType   @map("redemption_type")
  remunerationType InvestmentRemunerationType @map("remuneration_type")
  rateValue        Decimal                    @map("rate_value") @db.Decimal(65, 30)
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  sourceOffer      InvestmentOffer?           @relation(fields: [sourceOfferId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuer           InvestmentIssuer?          @relation(fields: [issuerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calculations     SimulationCalculation[]

  @@index([ownerId])
  @@map("simulation")
}

// Append-only record of one calculation with the inputs that produced it.
model SimulationCalculation {
  id                        String                         @id @db.Uuid
  simulationId              String                         @map("simulation_id") @db.Uuid
  indexCurveId              String?                        @map("index_curve_id") @db.Uuid
  principal                 Decimal                        @db.Decimal(65, 30)
  investmentDate            DateTime                       @map("investment_date") @db.Date
  methodologyVersion        String                         @map("methodology_version")
  calculatedAt              DateTime                       @map("calculated_at") @db.Timestamptz(3)
  grossBalance              Decimal                        @map("gross_balance") @db.Decimal(65, 30)
  grossEarnings             Decimal                        @map("gross_earnings") @db.Decimal(65, 30)
  iof                       Decimal                        @db.Decimal(65, 30)
  incomeTax                 Decimal                        @map("income_tax") @db.Decimal(65, 30)
  totalTaxes                Decimal                        @map("total_taxes") @db.Decimal(65, 30)
  netBalance                Decimal                        @map("net_balance") @db.Decimal(65, 30)
  // What IOF and income tax were derived from; a null rate means exempt.
  holdingPeriodCalendarDays Int                            @map("holding_period_calendar_days")
  taxableEarnings           Decimal                        @map("taxable_earnings") @db.Decimal(65, 30)
  incomeTaxBase             Decimal                        @map("income_tax_base") @db.Decimal(65, 30)
  iofRate                   Decimal?                       @map("iof_rate") @db.Decimal(65, 30)
  incomeTaxRate             Decimal?                       @map("income_tax_rate") @db.Decimal(65, 30)
  simulation                Simulation                     @relation(fields: [simulationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  indexCurve                IndexCurve?                    @relation(fields: [indexCurveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  balances                  SimulationCalculationBalance[]

  @@index([simulationId, calculatedAt(sort: Desc)])
  @@map("simulation_calculation")
}

model SimulationCalculationBalance {
  calculationId            String                @map("calculation_id") @db.Uuid
  date                     DateTime              @db.Date
  grossBalance             Decimal               @map("gross_balance") @db.Decimal(65, 30)
  dailyGrossEarnings       Decimal               @map("daily_gross_earnings") @db.Decimal(65, 30)
  accumulatedGrossEarnings Decimal               @map("accumulated_gross_earnings") @db.Decimal(65, 30)
  calculation              SimulationCalculation @relation(fields: [calculationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([calculationId, date])
  @@map("simulation_calculation_balance")
}

enum EconomicIndex {
  CDI
  SELIC
  IPCA

  @@map("economic_index")
}

model IndexCurve {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  index        EconomicIndex
  deletedAt    DateTime?               @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  intervals    IndexCurveInterval[]
  calculations SimulationCalculation[]

  @@map("index_curve")
}

model IndexCurveInterval {
  curveId   String     @map("curve_id") @db.Uuid
  startDate DateTime   @map("start_date") @db.Date
  endDate   DateTime   @map("end_date") @db.Date
  value     Decimal    @db.Decimal(65, 30)
  curve     IndexCurve @relation(fields: [curveId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([curveId, startDate])
  @@map("index_curve_interval")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  context       String
  occurredAt    DateTime  @map("occurred_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  id          String   @id @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}
