generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InvestmentTitleType {
  CDB
  LCI
  LCA

  @@map("investment_title_type")
}

enum InvestmentRedemptionType {
  AT_MATURITY
  DAILY

  @@map("investment_redemption_type")
}

enum InvestmentRemunerationType {
  PREFIXED
  CDI_PERCENTAGE
  SELIC_PERCENTAGE
  IPCA_PLUS

  @@map("investment_remuneration_type")
}

model Offer {
  id               String                     @id @db.Uuid
  ownerId          String?                    @map("owner_id")
  titleType        InvestmentTitleType        @map("title_type")
  name             String
  issuerName       String?                    @map("issuer_name")
  maturityDate     DateTime                   @map("maturity_date") @db.Date
  redemptionType   InvestmentRedemptionType   @map("redemption_type")
  remunerationType InvestmentRemunerationType @map("remuneration_type")
  rateValue        Decimal                    @map("rate_value") @db.Decimal(65, 30)
  revision         Int
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  simulations      Simulation[]

  @@index([ownerId])
  @@map("offer")
}

model Simulation {
  id             String            @id @db.Uuid
  ownerId        String            @map("owner_id")
  offerId        String            @map("offer_id") @db.Uuid
  // Null for fixed rates.
  curveId        String?           @map("curve_id") @db.Uuid
  principal      Decimal           @db.Decimal(65, 30)
  investmentDate DateTime          @map("investment_date") @db.Date
  revision       Int
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  offer          Offer             @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  curve          Curve?            @relation(fields: [curveId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  calculation    SimulationCalculation?
  result         SimulationResult?

  @@index([ownerId])
  @@index([offerId])
  @@index([curveId])
  @@map("simulation")
}

// The current result, replaced by each successful calculation, with the
// revisions and methodology it was calculated from.
enum SimulationCalculationStatus {
  PENDING
  CALCULATED
  INVALID
  FAILED

  @@map("simulation_calculation_status")
}

enum SimulationCalculationCauseKind {
  CREATED
  SIMULATION_EDITED
  OFFER_CHANGED
  OFFER_DELETED
  CURVE_CHANGED
  CURVE_DELETED
  METHODOLOGY_CHANGED
  RETRY_REQUESTED

  @@map("simulation_calculation_cause_kind")
}

// The current calculation state of a simulation; no history is kept.
model SimulationCalculation {
  simulationId       String                         @id @map("simulation_id") @db.Uuid
  status             SimulationCalculationStatus
  changedAt          DateTime                       @map("changed_at") @db.Timestamptz(3)
  causeKind          SimulationCalculationCauseKind @map("cause_kind")
  // The offer or curve whose change queued the calculation.
  causeRefId         String?                        @map("cause_ref_id") @db.Uuid
  // Null for system processes.
  causeActorId       String?                        @map("cause_actor_id")
  // The inputs the status applies to; outcomes are written only while the
  // simulation revision still matches.
  simulationRevision Int                            @map("simulation_revision")
  offerRevision      Int?                           @map("offer_revision")
  curveRevision      Int?                           @map("curve_revision")
  // Only for INVALID.
  reasonCode         String?                        @map("reason_code")
  reasonMetadata     Json?                          @map("reason_metadata")
  simulation         Simulation                     @relation(fields: [simulationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("simulation_calculation")
}

model SimulationResult {
  simulationId              String                    @id @map("simulation_id") @db.Uuid
  simulationRevision        Int                       @map("simulation_revision")
  offerRevision             Int                       @map("offer_revision")
  curveRevision             Int?                      @map("curve_revision")
  methodologyVersion        String                    @map("methodology_version")
  calculatedAt              DateTime                  @map("calculated_at") @db.Timestamptz(3)
  investmentDate            DateTime                  @map("investment_date") @db.Date
  maturityDate              DateTime                  @map("maturity_date") @db.Date
  principal                 Decimal                   @db.Decimal(65, 30)
  grossBalance              Decimal                   @map("gross_balance") @db.Decimal(65, 30)
  grossEarnings             Decimal                   @map("gross_earnings") @db.Decimal(65, 30)
  iof                       Decimal                   @db.Decimal(65, 30)
  incomeTax                 Decimal                   @map("income_tax") @db.Decimal(65, 30)
  totalTaxes                Decimal                   @map("total_taxes") @db.Decimal(65, 30)
  netBalance                Decimal                   @map("net_balance") @db.Decimal(65, 30)
  // What IOF and income tax were derived from; a null rate means exempt.
  holdingPeriodCalendarDays Int                       @map("holding_period_calendar_days")
  taxableEarnings           Decimal                   @map("taxable_earnings") @db.Decimal(65, 30)
  incomeTaxBase             Decimal                   @map("income_tax_base") @db.Decimal(65, 30)
  iofRate                   Decimal?                  @map("iof_rate") @db.Decimal(65, 30)
  incomeTaxRate             Decimal?                  @map("income_tax_rate") @db.Decimal(65, 30)
  // Business days from the investment date (excluded) to maturity (included),
  // which annualize the returns.
  businessDays              Int                       @map("business_days")
  // Read model for sorting and aggregation: written from the domain, which
  // derives the rates from the amounts and term and never reads them back.
  netAnnualReturn           Decimal                   @map("net_annual_return") @db.Decimal(65, 30)
  netMonthlyReturn          Decimal                   @map("net_monthly_return") @db.Decimal(65, 30)
  netPeriodReturn           Decimal                   @map("net_period_return") @db.Decimal(65, 30)
  grossAnnualReturn         Decimal                   @map("gross_annual_return") @db.Decimal(65, 30)
  grossMonthlyReturn        Decimal                   @map("gross_monthly_return") @db.Decimal(65, 30)
  grossPeriodReturn         Decimal                   @map("gross_period_return") @db.Decimal(65, 30)
  simulation                Simulation                @relation(fields: [simulationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  balances                  SimulationResultBalance[]

  @@index([netAnnualReturn])
  @@map("simulation_result")
}

model SimulationResultBalance {
  simulationId             String           @map("simulation_id") @db.Uuid
  date                     DateTime         @db.Date
  grossBalance             Decimal          @map("gross_balance") @db.Decimal(65, 30)
  dailyGrossEarnings       Decimal          @map("daily_gross_earnings") @db.Decimal(65, 30)
  accumulatedGrossEarnings Decimal          @map("accumulated_gross_earnings") @db.Decimal(65, 30)
  result                   SimulationResult @relation(fields: [simulationId], references: [simulationId], onDelete: Restrict, onUpdate: Restrict)

  @@id([simulationId, date])
  @@map("simulation_result_balance")
}

enum EconomicIndex {
  CDI
  SELIC
  IPCA

  @@map("economic_index")
}

// A null owner means system content, visible to every user.
model Curve {
  id          String          @id @db.Uuid
  ownerId     String?         @map("owner_id")
  index       EconomicIndex
  name        String
  description String?
  revision    Int
  deletedAt   DateTime?       @map("deleted_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  intervals   CurveInterval[]
  simulations Simulation[]

  @@index([ownerId])
  @@map("curve")
}

model CurveInterval {
  curveId   String   @map("curve_id") @db.Uuid
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  value     Decimal  @db.Decimal(65, 30)
  curve     Curve    @relation(fields: [curveId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([curveId, startDate])
  @@map("curve_interval")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  context       String
  occurredAt    DateTime  @map("occurred_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastError     String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, eventId])
  @@map("processed_events")
}
