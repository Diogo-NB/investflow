{
  "name": "portfolio-domain",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/portfolio/domain/src",
  "projectType": "library",
  "tags": ["scope:portfolio", "layer:domain"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/portfolio/domain",
        "tsConfig": "libs/portfolio/domain/tsconfig.lib.json",
        "packageJson": "libs/portfolio/domain/package.json",
        "main": "libs/portfolio/domain/src/index.ts",
        "assets": ["libs/portfolio/domain/*.md"]
      }
    }
  }
}
