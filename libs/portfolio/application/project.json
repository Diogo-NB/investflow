{
  "name": "portfolio-application",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/portfolio/application/src",
  "projectType": "library",
  "tags": ["scope:portfolio", "layer:application"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/portfolio/application",
        "tsConfig": "libs/portfolio/application/tsconfig.lib.json",
        "packageJson": "libs/portfolio/application/package.json",
        "main": "libs/portfolio/application/src/index.ts",
        "assets": ["libs/portfolio/application/*.md"]
      }
    }
  }
}
