{
  "name": "tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools",
  "tags": ["scope:tools", "platform:server"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "commands": [
          "tsc -p tools/database/tsconfig.json",
          "tsc -p tools/benchmarks/tsconfig.json"
        ],
        "parallel": false
      }
    }
  }
}
