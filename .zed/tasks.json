[
  {
    "label": "InvestFlow: Run API",
    "command": "source \"${NVM_DIR:-$HOME/.nvm}/nvm.sh\" && nvm use && pnpm db:up && pnpm start:api",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": { "NX_DAEMON": "false" },
    "shell": { "program": "/bin/bash" },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "InvestFlow: Run Web",
    "command": "source \"${NVM_DIR:-$HOME/.nvm}/nvm.sh\" && nvm use && pnpm start:web",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": { "NX_DAEMON": "false" },
    "shell": { "program": "/bin/bash" },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "InvestFlow: Run All Apps",
    "command": "source \"${NVM_DIR:-$HOME/.nvm}/nvm.sh\" && nvm use && pnpm start",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": { "NX_DAEMON": "false" },
    "shell": { "program": "/bin/bash" },
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  }
]
